APP_NAME=Recipe Book API
PORT=7000
NODE_ENV=development

# Generate each secret with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
CSRF_SECRET=replace_with_a_different_long_random_secret

# Where this API runs, and the frontend origin(s) allowed by CORS (comma-separated).
BACKEND_URL=http://localhost:7000
FRONTEND_URL=http://localhost:5173

# Neon connection string (Dashboard > Connect). Keep ?sslmode=require at the end.
DATABASE_URL=postgresql://user:password@your-project.neon.tech/neondb?sslmode=require

# First admin account, created by `npm run db:seed`.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123

# Optional demo USER account with 8 sample Filipino recipes, created by `npm run db:seed`.
DEMO_USER_NAME=Juan Dela Cruz
DEMO_USER_EMAIL=user@example.com
DEMO_USER_PASSWORD=ChangeMe123

# Day boundaries for the admin dashboard chart.
APP_TIMEZONE=Asia/Manila
